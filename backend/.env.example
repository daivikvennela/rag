# All values are optional; defaults mirror Main.ipynb.

# Vector store
# CHROMA_PATH=./chroma_db
# COLLECTION_NAME=financial_news
# CORPUS_PATH=./data/corpus.parquet

# Models (swap EMBED_MODEL to BAAI/bge-small-en-v1.5 for stronger retrieval)
# EMBED_MODEL=all-distilroberta-v1
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval defaults
# DEFAULT_METHOD=rerank
# DEFAULT_K=5
# MAX_K=20

# CORS (comma-separated origins allowed to call the API)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kaggle dataset (ingest.py)
# KAGGLE_DATASET=rdolphin/financial-news-with-ticker-level-sentiment
# KAGGLE_FILE=polygon_news_sample.json
